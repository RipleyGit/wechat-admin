PROFILE_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18088
JAVA_OPTS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m

MYSQL_IP=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wx
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me

REDIS_IP=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

# ===== 门户小程序（/wx/wxMiniUser/*）=====
# 小程序的 appid 和 AppSecret 不再走环境变量，已改为存在 wx_account 表的
# mini_appid / mini_secret 两列，在运营台「选择工作公众号 → 配置」里填写。
# 这样每个公众号能配自己的门户小程序，不再是一套 jar 只能配一个。
# 迁移脚本：db/migrations/20261026_add_wx_account_mini.sql
#
# 原先的 WX_MINI_APPID / WX_MINI_SECRET / WX_MINI_SERVICE_APPID 都已废弃，
# 留在 env 文件里不会报错，但也不再生效，可以删掉。
#
# 是否允许调用方直传 miniOpenid 登录。/wx/** 在 ShiroConfig 里是 anon，
# 直传 openid 等于可以伪造他人身份。页面上配好 AppSecret 后请改成 false，只留 code 登录。
WX_MINI_ALLOW_OPENID_LOGIN=false
