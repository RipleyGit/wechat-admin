PROFILE_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18088
JAVA_OPTS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m

MYSQL_IP=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wx
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me

REDIS_IP=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

# ===== 门户小程序（/wx/wxMiniUser/*）=====
# WX_MINI_SECRET 是小程序的 AppSecret，在微信公众平台
# 「开发管理 → 开发设置 → 开发者ID」查看（只显示一次，重置会让旧值失效）。
# 不配的话 code 换 openid 这条路走不通，登录接口直接返回
# 「未配置 wx.mini.secret」——门户会降级成显示全部应用。
WX_MINI_APPID=wx62c3973df7065a2b
WX_MINI_SECRET=replace-me
# 关联的服务号 appid，用于把小程序用户关联到公众号粉丝（wx_user）
WX_MINI_SERVICE_APPID=wxfd938c6a7ced4eab
# 是否允许调用方直传 miniOpenid 登录。/wx/** 在 ShiroConfig 里是 anon，
# 直传 openid 等于可以伪造他人身份。配好 SECRET 后请改成 false，只留 code 登录。
WX_MINI_ALLOW_OPENID_LOGIN=false
